{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the app's windows",
  "windows": [
    "main",
    "island",
    "settings"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://ollama.com/*" }, { "url": "https://huggingface.co/*" }]
    }
  ]
}
