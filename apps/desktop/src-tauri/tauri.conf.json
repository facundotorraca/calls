{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calls",
  "version": "0.1.0",
  "identifier": "dev.facundotorraca.calls",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Calls",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "theme": "Dark",
        "backgroundColor": "#070707"
      },
      {
        "label": "island",
        "url": "index.html",
        "title": "Calls",
        "width": 360,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/whisper-cli",
      "binaries/calls-audio"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../../../workers/": "workers/"
    }
  }
}
