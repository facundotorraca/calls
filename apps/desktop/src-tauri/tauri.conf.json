{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ftor-calls",
  "version": "0.1.1",
  "identifier": "dev.facundotorraca.calls",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ftor-calls",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "theme": "Dark",
        "backgroundColor": "#070707"
      },
      {
        "label": "island",
        "url": "index.html",
        "title": "ftor-calls",
        "width": 360,
        "height": 40,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0QkZBNTk5QkU3NEJEQkMKUldTOHZYUyttYVcvZEdoUUpBSGxXallVdVNYbnhQYzZrT3AzTFVtaTd4WnQzTUdkV0F6MWFqNkoK",
      "endpoints": ["https://apps.ftor.dev/calls/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Records and transcribes your calls, all on your Mac.",
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/whisper-cli",
      "binaries/calls-audio"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../../../workers/": "workers/"
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist"
    }
  }
}
